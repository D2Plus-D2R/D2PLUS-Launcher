{
  "news": [
    {
      "id": "alpha-v13",
      "date": "October 26, 2026",
      "tag": "Alpha V1.3",
      "title": "A little weight. A lot of choice.",
      "summary": "Choose your charms and craft an Oath for you and your allies.",
      "body": [
        "Charm capacity is 50. Each point above 50 reduces maximum life and mana by 15%, capped at 90%. See Advanced Character Stats for the total and limit.",
        "Magic small / large / grand charms weigh 1 / 2 / 3. Unique and Sunder charms weigh 5, the melee splash charm weighs 1, and crafted Oaths weigh 7.",
        "Seven craftable Oaths grant an aura to you and nearby allies, including mercenaries. Each can roll aura level 1–20; the tooltip shows the bonuses for its actual level.",
        "Cube a magic Grand Charm, three matching Elder Gems and one Worldforge Shard; transmute twice to finish the Oath. One Oath per character.",
        "Unique Grand Charms can be Accursed. Success adds one weight; a brick becomes a magic charm of the same base. Small and large unique charms remain ineligible.",
        "Elder Gems and supported crafting materials use orange names. The Hero Editor recognizes the new charm stats and Oaths.",
        "Three brand-new dungeons are in development: one for early game, one for mid game, and a mythic endgame dungeon. They are not included in Alpha V1.3."
      ]
    },
    {
      "id": "alpha-v122",
      "date": "October 24, 2026",
      "tag": "Alpha V1.2.2",
      "title": "Controller polish and safer saves",
      "summary": "Controller HUD and stash fixes, save tools and a quick start guide.",
      "body": [
        "Dark gothic controller HUD, improved potion alignment and controller stash, and a cleaner inventory surround.",
        "The launcher shows the exact save folder, with Open Saves and Back Up Saves. Offline map rerolling remains available.",
        "Getting Started guide and Alpha V1.2.2 splash."
      ]
    }
  ],
  "patchNotes": [
    {
      "id": "alpha-v13",
      "version": "Alpha V1.3",
      "date": "October 26, 2026",
      "status": "Released alpha",
      "title": "Charm weight and Oaths",
      "summary": "Charm weight, seven craftable ally-aura Oaths, exact tooltips and updated reference tools.",
      "sections": [
        {
          "title": "Charms and crafting",
          "bullets": [
            "Charm capacity is 50. Each point above 50 reduces maximum life and mana by 15%, capped at 90%. See Advanced Character Stats for the total and limit.",
            "Magic small / large / grand charms weigh 1 / 2 / 3. Unique and Sunder charms weigh 5, the melee splash charm weighs 1, and crafted Oaths weigh 7.",
            "Seven craftable Oaths grant an aura to you and nearby allies, including mercenaries. Each can roll aura level 1–20; the tooltip shows the bonuses for its actual level.",
            "Cube a magic Grand Charm, three matching Elder Gems and one Worldforge Shard; transmute twice to finish the Oath. One Oath per character.",
            "Unique Grand Charms can be Accursed. Success adds one weight; a brick becomes a magic charm of the same base. Small and large unique charms remain ineligible.",
            "Elder Gems and supported crafting materials use orange names. The Hero Editor recognizes the new charm stats and Oaths."
          ]
        },
        {
          "title": "Updating existing characters",
          "bullets": [
            "Back up saves, install the complete package, and keep your existing output mod name and save path.",
            "For a legacy charm missing its weight line, cube it with one Scroll of Identify to add weight without rerolling its existing bonuses.",
            "No runtime plugin or extra loader is required for the charm system."
          ]
        },
        {
          "title": "Earlier updates included",
          "bullets": [
            "Lilith, Daughter of Hatred joins Mephisto in Normal, Nightmare and Hell. Lilith does not drop his trophy.",
            "Azmodan animation improvements and Mephisto targeting fixes.",
            "Controller HUD and stash improvements, launcher save-folder tools and offline-map rerolling."
          ]
        }
      ]
    },
    {
      "id": "alpha-v122",
